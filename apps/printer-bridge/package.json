{
    "name": "printer-bridge",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "electron .",
        "start-headless": "node headless.js",
        "dist": "electron-builder",
        "dist-headless": "pkg headless.js --targets node18-win-x64 --output dist-headless/spoolyprinter-console.exe",
        "postinstall": "electron-builder install-app-deps"
    },
    "pkg": {
        "assets": [
            "node_modules/**/*"
        ]
    },
    "build": {
        "appId": "com.spooly.printerbridge",
        "productName": "SpoolyPrinterBridge",
        "mac": {
            "target": "dmg",
            "icon": "icon.png"
        },
        "linux": {
            "target": "AppImage",
            "icon": "icon.png"
        },
        "win": {
            "target": "portable",
            "icon": "icon.png",
            "artifactName": "${productName}.exe"
        },
        "directories": {
            "output": "dist-final"
        },
        "asar": true
    },
    "keywords": [],
    "author": "",
    "license": "AGPL-3.0-or-later",
    "description": "Bridge for 3D Printers (Bambu/Creality)",
    "dependencies": {
        "axios": "^1.6.0",
        "basic-ftp": "^5.1.0",
        "mqtt": "^5.0.0",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "electron": "^40.0.0",
        "electron-builder": "^26.4.0",
        "pkg": "^5.8.1"
    }
}
