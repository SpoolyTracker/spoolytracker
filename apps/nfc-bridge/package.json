{
  "name": "nfc-bridge",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder",
    "dist-headless": "pkg headless.js --targets node18-win-x64 --output dist-headless/spoolynfc-console.exe",
    "postinstall": "electron-builder install-app-deps || exit 0"
  },
  "pkg": {
    "assets": [
      "node_modules/**/*"
    ]
  },
  "build": {
    "appId": "com.spooly.nfcbridge",
    "productName": "SpoolyNFC",
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png",
      "artifactName": "${productName}.exe"
    },
    "directories": {
      "output": "dist-final"
    },
    "asar": true
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "nfc-pcsc": "^0.8.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "pkg": "^5.8.1"
  }
}