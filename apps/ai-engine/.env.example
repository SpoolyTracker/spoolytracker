AI_ENGINE_APP_NAME="Spooly AI Engine"
AI_ENGINE_APP_VERSION="0.1.0"
AI_ENGINE_ENV="local"
AI_ENGINE_DEBUG=false
AI_ENGINE_HOST="0.0.0.0"
AI_ENGINE_PORT=8000
AI_ENGINE_MEMORY_DB_PATH="ai_engine_memory.sqlite3"

# Optional bearer token for future service-to-service calls.
# AI_ENGINE_INTERNAL_API_TOKEN="change-me"

# Main NestJS API used for real organization stock, projects and consumption data.
AI_ENGINE_APP_API_URL="http://localhost:3000"
# AI_ENGINE_APP_API_TOKEN="change-me"

# Optional LLM integration. The engine works without a LLM.
AI_LLM_PROVIDER="none"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Keep false unless the deployment explicitly allows sending richer app context to a LLM.
AI_ALLOW_SENSITIVE_LLM_CONTEXT=false
AI_ENGINE_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Optional local rack vision model. Train with:
# python -m src.vision.train_rack_detector --data datasets/rack-spools/data.yaml
RACK_VISION_MODEL_PATH="models/rack-spool-detector.pt"
RACK_VISION_CONFIDENCE=0.35
